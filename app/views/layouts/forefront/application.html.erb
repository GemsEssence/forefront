<!DOCTYPE html>
<html>
  <head>
    <title>Forefront</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= turbo_include_tags %>

    <%= yield :head %>

    <script>
      // Modals (forefront/shared/_modal): open/close by id. Closing also clears
      // any validation errors so the form is fresh the next time it's opened.
      function forefrontOpenModal(id) {
        var el = document.getElementById(id);
        if (el) el.style.display = 'flex';
      }
      function forefrontCloseModal(id) {
        var el = document.getElementById(id);
        if (!el) return;
        el.style.display = 'none';
        var errors = el.querySelector('[data-modal-errors]');
        if (errors) errors.remove();
      }
    </script>

    <!-- Load TailwindCSS via CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <%= stylesheet_link_tag    "forefront/application", media: "all" %>
    <!-- Note: This gem uses Tailwind CSS classes. Make sure Tailwind CSS is configured in your host application. -->
  </head>
  <body>
    <div class="min-h-screen bg-gray-50">
      <% if admin_signed_in? %>
        <header class="sticky top-0 z-30 bg-white shadow h-16 flex items-center px-4 sm:px-6">
          <button type="button" class="lg:hidden mr-3 rounded-md p-2 text-gray-600 hover:bg-gray-100" aria-controls="forefront-sidebar" aria-label="Menu"
                  onclick="document.getElementById('forefront-sidebar').classList.toggle('hidden')">&#9776;</button>
          <%= link_to "Forefront", root_path, class: "text-xl font-bold text-gray-900 hover:text-indigo-600" %>
        </header>
        <div class="lg:flex">
          <%= render "forefront/shared/sidebar" %>
          <main class="flex-1 min-w-0 py-6 px-4 sm:px-6 lg:px-8">
            <%= yield %>
          </main>
        </div>
      <% else %>
        <main class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
          <div class="px-4 py-6 sm:px-0">
            <%= yield %>
          </div>
        </main>
      <% end %>
    </div>
  </body>
</html>
