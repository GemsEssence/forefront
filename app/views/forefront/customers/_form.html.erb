<%= form_with model: @customer, url: path, local: true, class: "space-y-6" do |f| %>
  <div>
    <%= f.label :name, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500", required: true %>
  </div>

  <p class="text-sm text-gray-500">Provide at least one of email or phone.</p>

  <div>
    <%= f.label :email, class: "block text-sm font-medium text-gray-700" %>
    <% hidden = @customer.persisted? && !policy(@customer).see_contact_details? %>
    <% if hidden %>
      <p class="text-xs text-gray-500">Contact details are hidden. Leave a field blank to keep it, or type a new value to replace it.</p>
    <% end %>
    <%= f.email_field :email, value: (hidden ? nil : @customer.email), placeholder: (@customer.masked_email if hidden), class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
  </div>

  <div class="grid grid-cols-4 gap-4">
    <div>
      <%= f.label :country_code, "Country code", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :country_code, value: @customer.country_code || Forefront::Settings.current.default_country_code, placeholder: "+91", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>
    <div class="col-span-3">
      <%= f.label :phone, class: "block text-sm font-medium text-gray-700" %>
      <%= f.telephone_field :phone, value: (hidden ? nil : @customer.phone), placeholder: (@customer.masked_phone if hidden), class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>
  </div>

  <div>
    <%= f.label :business_name, "Business Name (optional)", class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :business_name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
  </div>

  <div>
    <%= f.label :address, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_area :address, rows: 3, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
  </div>

  <% if Forefront.plugin_mode %>
    <div class="border-t pt-4">
      <p class="text-sm font-medium text-gray-700 mb-2">Host Application Link (optional)</p>
      <p class="text-xs text-gray-500 mb-3">Connects this Customer to a record in a parent application, when Forefront is used as a plugin.</p>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :external_type, "External Type", class: "block text-sm font-medium text-gray-700" %>
          <%= f.text_field :external_type, placeholder: "e.g. User", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
        </div>
        <div>
          <%= f.label :external_id, "External ID", class: "block text-sm font-medium text-gray-700" %>
          <%= f.text_field :external_id, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
        </div>
      </div>
    </div>
  <% end %>

  <div class="flex justify-end space-x-3">
    <%= link_to "Cancel", path, class: "bg-gray-300 hover:bg-gray-400 text-gray-800 px-4 py-2 rounded-md text-sm font-medium" %>
    <%= f.submit class: "bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-md text-sm font-medium" %>
  </div>
<% end %>
