<div class="mb-4">
  <%= link_to "← Performance", performance_path, class: "text-sm text-indigo-600 hover:text-indigo-800" %>
  <h2 class="text-2xl font-bold text-gray-900"><%= @person.name %> · last 12 months</h2>
  <p class="text-sm text-gray-500"><%= @scope.description %></p>
</div>

<div class="bg-white shadow rounded-lg overflow-x-auto">
  <table class="min-w-full divide-y divide-gray-200 text-sm" data-performance>
    <thead class="bg-gray-50">
      <tr>
        <th class="px-3 py-2 text-left">Month</th>
        <% Forefront::Performance::TREND_COLUMNS.each do |column| %>
          <th class="px-3 py-2 text-right"><%= column.title %></th>
        <% end %>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @rows.each do |row| %>
        <tr data-row="<%= row.label %>">
          <td class="px-3 py-2 font-medium"><%= row.label %></td>
          <% Forefront::Performance::TREND_COLUMNS.each do |column| %>
            <%= performance_cell(row, column) %>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
