<div class="min-h-screen bg-gray-50">
  <div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
    <div class="px-4 py-6 sm:px-0">
      <h1 class="text-3xl font-bold text-gray-900 mb-2">Unassigned</h1>
      <p class="text-sm text-gray-500 mb-6">Work nobody has picked up yet<%= current_admin.sales_person? ? " for the products allocated to you" : "" %>.</p>

      <%= render "forefront/shared/messages" %>

      <% [ [ "Tickets", @tickets ], [ "Leads", @leads ] ].each do |heading, records| %>
        <h2 class="text-lg font-medium text-gray-900 mt-6 mb-2"><%= heading %></h2>
        <div class="bg-white shadow sm:rounded-md">
          <% if records.any? %>
            <ul class="divide-y divide-gray-200">
              <% records.each do |record| %>
                <li class="px-4 py-3 flex items-center justify-between text-sm">
                  <span>
                    <span class="font-medium text-gray-900"><%= record.title %></span>
                    <span class="text-gray-500">· <%= record.customer.name %><%= " · #{record.product.name}" if record.product %> · waiting since <%= record.created_at.strftime("%-d %b") %></span>
                  </span>
                  <% if policy(record).take? %>
                    <%= button_to "Take", polymorphic_path([ record, :take ]), method: :post, class: "bg-indigo-600 hover:bg-indigo-700 text-white px-3 py-1 rounded text-sm" %>
                  <% elsif policy(record).change_assignee? %>
                    <%= link_to "Assign", polymorphic_path(record), class: "text-indigo-600 hover:text-indigo-500 font-medium" %>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="px-4 py-3 text-sm text-gray-500">Nothing waiting.</p>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
