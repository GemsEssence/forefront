<%# locals: required (true when the record will have an assignee); values: (submitted first_step params) %>
<% values = local_assigns[:values] || {} %>
<% default_at = Forefront::Followup.next_working_day_at.strftime("%Y-%m-%dT%H:%M") %>
<fieldset class="border rounded-md p-3" data-first-step>
  <legend class="text-sm font-medium text-gray-700 px-1">First step</legend>
  <p class="text-xs text-gray-500 mb-2">What the assignee does next. <%= required ? "Required." : "Optional for the pool: whoever takes it sets one." %></p>
  <div class="grid grid-cols-2 gap-4">
    <div>
      <label for="first_step_followup_type" class="block text-xs font-medium text-gray-700">Do</label>
      <%= select_tag "first_step[followup_type]", options_for_select(Forefront::Followup.followup_types.keys.map { |k| [ k.humanize, k ] }, values[:followup_type].presence || "call"), id: "first_step_followup_type", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm text-sm" %>
    </div>
    <div>
      <label for="first_step_scheduled_for" class="block text-xs font-medium text-gray-700">On</label>
      <%= datetime_local_field_tag "first_step[scheduled_for]", values.key?(:scheduled_for) ? values[:scheduled_for] : default_at, id: "first_step_scheduled_for", required: required, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm text-sm" %>
    </div>
  </div>
</fieldset>
