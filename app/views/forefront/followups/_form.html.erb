<%# locals: followupable; on a failed submit also errors:, open: true, followup: (the unsaved followup) %>
<% followup = local_assigns[:followup] || Forefront::Followup.new %>
<% id = modal_id(:followup, followupable) %>
<%= render layout: "forefront/shared/modal", locals: { id: id, title: "Schedule Followup", open: local_assigns[:open], errors: local_assigns[:errors] } do %>
  <%= form_with model: followup, url: polymorphic_path([followupable, :followups]), method: :post, data: { turbo_frame: '_top' } do |f| %>
    <div class="mb-3">
      <%= f.label :followup_type, 'Type', class: 'block text-sm font-medium text-gray-700' %>
      <%= f.select :followup_type, Forefront::Followup.followup_types.map { |k, v| [k.humanize, k] }, { prompt: 'Select type' }, { class: 'mt-1 block w-full border rounded', required: true } %>
    </div>

    <div class="mb-3">
      <%= f.label :scheduled_for, "Scheduled For", class: 'block text-sm font-medium text-gray-700' %>
      <%= f.datetime_local_field :scheduled_for, value: followup.scheduled_for&.strftime("%Y-%m-%dT%H:%M"), class: 'mt-1 block w-full border rounded', required: true %>
    </div>

    <div class="mb-3">
      <%= f.label :assigned_to_id, "Assign to", class: 'block text-sm font-medium text-gray-700' %>
      <%= f.collection_select :assigned_to_id, Forefront::Admin.all.order(:name), :id, :name, { prompt: "Default: #{followupable.assigned_to&.name || 'Unassigned'}", selected: followup.assigned_to_id || followupable.assigned_to_id }, { class: 'mt-1 block w-full border rounded' } %>
    </div>

    <div class="mb-3">
      <%= f.label :outcome, 'Notes', class: 'block text-sm font-medium text-gray-700' %>
      <%= f.text_area :outcome, rows: 3, placeholder: 'Add any notes about this followup', class: 'mt-1 block w-full border rounded' %>
    </div>

    <div class="flex justify-end space-x-2">
      <button type="button" onclick="forefrontCloseModal('<%= id %>')" class="px-3 py-1 border rounded">Cancel</button>
      <%= f.submit 'Schedule Followup', class: 'bg-indigo-600 text-white px-3 py-1 rounded' %>
    </div>
  <% end %>
<% end %>
