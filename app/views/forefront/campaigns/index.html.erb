<div class="min-h-screen bg-gray-50">
  <div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
    <div class="px-4 py-6 sm:px-0">
      <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold text-gray-900">Campaigns</h1>
        <%= link_to "New Campaign", new_campaign_path, class: "bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-md text-sm font-medium" %>
      </div>

      <%= render "forefront/shared/messages" %>

      <div class="bg-white shadow overflow-hidden sm:rounded-md">
        <% if @campaigns.any? %>
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Runs on</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">From</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">To</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <% @campaigns.each do |campaign| %>
                <tr>
                  <td class="px-4 py-3 text-sm font-medium"><%= link_to campaign.name, campaign_path(campaign), class: "text-indigo-600 hover:text-indigo-500" %></td>
                  <td class="px-4 py-3 text-sm text-gray-700"><%= campaign.source.name %></td>
                  <td class="px-4 py-3 text-sm text-gray-700"><%= campaign.starts_on.strftime("%-d %b %Y") %></td>
                  <td class="px-4 py-3 text-sm text-gray-700"><%= campaign.ends_on.strftime("%-d %b %Y") %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <div class="text-center py-12">
            <p class="text-gray-500">No campaigns yet.</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
