<%= form_with model: @campaign, url: path, local: true, class: "space-y-6" do |f| %>
  <div>
    <%= f.label :name, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :name, required: true, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
  </div>

  <div>
    <%= f.label :source_id, "Runs on", class: "block text-sm font-medium text-gray-700" %>
    <%= f.collection_select :source_id, Forefront::Source.active.or(Forefront::Source.where(id: @campaign.source_id)).ordered, :id, :name, { prompt: "Select a source" }, { required: true, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" } %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :starts_on, "From", class: "block text-sm font-medium text-gray-700" %>
      <%= f.date_field :starts_on, required: true, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>
    <div>
      <%= f.label :ends_on, "To", class: "block text-sm font-medium text-gray-700" %>
      <%= f.date_field :ends_on, required: true, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>
  </div>

  <div class="flex justify-end space-x-3">
    <%= link_to "Cancel", campaigns_path, class: "bg-gray-300 hover:bg-gray-400 text-gray-800 px-4 py-2 rounded-md text-sm font-medium" %>
    <%= f.submit class: "bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-md text-sm font-medium" %>
  </div>
<% end %>
