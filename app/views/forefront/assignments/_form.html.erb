<%# locals: assignable, admins; on a failed submit also errors:, open: true, values: (the submitted assignment params) %>
<% values = local_assigns[:values] || {} %>
<% id = modal_id(:assignment, assignable) %>
<%= render layout: "forefront/shared/modal", locals: { id: id, title: "Assign #{assignable.class.name.demodulize}", open: local_assigns[:open], errors: local_assigns[:errors] } do %>
  <%= form_with url: polymorphic_path([assignable, :assignments]), scope: :assignment, method: :post, data: { turbo_frame: '_top' }, html: { class: 'assignment-form' } do |f| %>
    <div class="mb-3">
      <%= f.label :to_user_id, 'Assignee', class: 'block text-sm font-medium text-gray-700' %>
      <%= f.select :to_user_id, options_from_collection_for_select(admins, :id, :name, values[:to_user_id].presence || assignable.assigned_to_id), {}, class: 'mt-1 block w-full border rounded', required: true %>
    </div>

    <div class="mb-3">
      <%= f.label :note, 'Note (optional)', class: 'block text-sm font-medium text-gray-700' %>
      <%= f.text_area :note, value: values[:note], rows: 3, class: 'mt-1 block w-full border rounded' %>
    </div>

    <div class="flex justify-end space-x-2">
      <button type="button" onclick="forefrontCloseModal('<%= id %>')" class="px-3 py-1 border rounded">Cancel</button>
      <%= f.submit 'Assign', class: 'bg-indigo-600 text-white px-3 py-1 rounded' %>
    </div>
  <% end %>
<% end %>
