<%= form_with model: @admin, url: path, local: true, class: "space-y-6" do |f| %>
  <div>
    <%= f.label :name, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500", required: true %>
  </div>

  <div>
    <%= f.label :email, class: "block text-sm font-medium text-gray-700" %>
    <%= f.email_field :email, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500", required: true %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :password, @admin.persisted? ? "New password (leave blank to keep current)" : "Password", class: "block text-sm font-medium text-gray-700" %>
      <%= f.password_field :password, autocomplete: "new-password", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500", required: !@admin.persisted? %>
    </div>

    <div>
      <%= f.label :password_confirmation, "Confirm password", class: "block text-sm font-medium text-gray-700" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500", required: !@admin.persisted? %>
    </div>
  </div>

  <% if current_admin.admin? %>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :role, class: "block text-sm font-medium text-gray-700" %>
        <%= f.select :role, options_for_select(Forefront::Admin.roles.keys.map { |k| [k.humanize, k] }, @admin.role), {}, { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500", required: true, onchange: "toggleProductAllocation(this)" } %>
      </div>

      <div>
        <%= f.label :manager_id, "Manager", class: "block text-sm font-medium text-gray-700" %>
        <%= f.select :manager_id, options_from_collection_for_select(Forefront::Admin.manager, :id, :name, @admin.manager_id), { include_blank: "No manager" }, { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" } %>
      </div>
    </div>
  <% else %>
    <p class="text-sm text-gray-500">Role: Sales person, reporting to you.</p>
  <% end %>

  <div id="product_allocation" style="<%= 'display:none;' unless @admin.sales_person? %>">
    <p class="block text-sm font-medium text-gray-700 mb-2">Allocated Products</p>
    <%= hidden_field_tag "admin[product_ids][]", "", id: nil %>
    <% if @products.any? %>
      <div class="space-y-2">
        <% @products.each do |product| %>
          <label class="flex items-center">
            <%= check_box_tag "admin[product_ids][]", product.id, @admin.product_ids.include?(product.id), id: "product_ids_#{product.id}", class: "rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
            <span class="ml-2 text-sm text-gray-700"><%= product.name %></span>
          </label>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-gray-500">No products yet.</p>
    <% end %>
    <p class="text-xs text-gray-500 mt-2">A sales person can only be given leads for their allocated products. Managers and admins can sell every product.</p>
  </div>

  <script>
    function toggleProductAllocation(select) {
      document.getElementById('product_allocation').style.display = select.value === 'sales_person' ? '' : 'none';
    }
  </script>

  <div class="flex justify-end space-x-3">
    <%= link_to "Cancel", admins_path, class: "bg-gray-300 hover:bg-gray-400 text-gray-800 px-4 py-2 rounded-md text-sm font-medium" %>
    <%= f.submit class: "bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-md text-sm font-medium" %>
  </div>
<% end %>
