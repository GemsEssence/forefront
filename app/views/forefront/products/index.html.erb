<div class="min-h-screen bg-gray-50">
  <div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
    <div class="px-4 py-6 sm:px-0">
      <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold text-gray-900">Products</h1>
        <% if policy(Forefront::Product).new? %>
          <%= link_to "New Product", new_product_path, class: "bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-md text-sm font-medium" %>
        <% end %>
      </div>

      <%= render "forefront/shared/messages" %>

      <div class="bg-white shadow overflow-hidden sm:rounded-md">
        <% if @products.any? %>
          <ul class="divide-y divide-gray-200">
            <% @products.each do |product| %>
              <li class="px-4 py-4 sm:px-6 flex items-center justify-between">
                <div>
                  <p class="text-sm font-medium text-indigo-600"><%= product.name %></p>
                  <% if product.description.present? %>
                    <p class="text-sm text-gray-500"><%= truncate(product.description, length: 100) %></p>
                  <% end %>
                </div>
                <div class="flex items-center space-x-4">
                  <span class="text-sm text-gray-500">
                    <%= pluralize(product.admins.count, "sales person") %> allocated
                  </span>
                  <% if policy(product).edit? %>
                    <%= link_to "Edit", edit_product_path(product), class: "text-indigo-600 hover:text-indigo-500 text-sm font-medium" %>
                  <% end %>
                </div>
              </li>
            <% end %>
          </ul>
        <% else %>
          <div class="text-center py-12">
            <p class="text-gray-500">No products found.</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
