<%# locals: lead; on a failed submit also errors:, open: true, values: (the submitted reopen params) %>
<% values = local_assigns[:values] || {} %>
<% id = modal_id(:reopen, lead) %>
<%= render layout: "forefront/shared/modal", locals: { id: id, title: "Reopen Lead", open: local_assigns[:open], errors: local_assigns[:errors] } do %>
  <%= form_with url: lead_reopen_path(lead), scope: :reopen, method: :post, data: { turbo_frame: '_top' }, html: { class: 'reopen-form' } do |f| %>
    <p class="text-sm text-gray-600 mb-3">The lead goes back to Open and forgets why it was lost. Choose who works it next.</p>
    <div class="mb-3">
      <%= f.label :assigned_to_id, 'Assign to', class: 'block text-sm font-medium text-gray-700' %>
      <%= f.select :assigned_to_id, options_from_collection_for_select(lead.eligible_assignees, :id, :name, values[:assigned_to_id].presence || lead.assigned_to_id), { include_blank: "Unassigned (pool)" }, class: 'mt-1 block w-full border rounded' %>
    </div>

    <div class="mb-3">
      <%= f.label :note, 'Note (optional)', class: 'block text-sm font-medium text-gray-700' %>
      <%= f.text_area :note, value: values[:note], rows: 3, class: 'mt-1 block w-full border rounded' %>
    </div>

    <div class="flex justify-end space-x-2">
      <button type="button" onclick="forefrontCloseModal('<%= id %>')" class="px-3 py-1 border rounded">Cancel</button>
      <%= f.submit 'Reopen', class: 'bg-indigo-600 text-white px-3 py-1 rounded' %>
    </div>
  <% end %>
<% end %>
