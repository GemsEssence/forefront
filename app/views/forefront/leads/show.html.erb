<div class="min-h-screen bg-gray-50">
  <div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
    <div class="px-4 py-6 sm:px-0">
        <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold text-gray-900"><%= @lead.title %></h1>
        <div class="flex space-x-2">
          <% if policy(@lead).update? %>
            <%= link_to "Edit", edit_lead_path(@lead), class: "bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-md text-sm font-medium" %>
          <% end %>
          <% if policy(@lead).destroy? %>
            <%= button_to "Delete", lead_path(@lead), method: :delete, form: { data: { turbo_confirm: "Are you sure?" } }, class: "bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-md text-sm font-medium" %>
          <% end %>
          <%= link_to "Back", leads_path, class: "bg-gray-300 hover:bg-gray-400 text-gray-800 px-4 py-2 rounded-md text-sm font-medium" %>
        </div>
      </div>

      <div id="flash_messages">
        <%= render "forefront/shared/messages" %>
      </div>

      <div class="bg-white shadow overflow-hidden sm:rounded-lg">
        <div class="px-4 py-5 sm:px-6">
          <div class="flex items-center space-x-4">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium <%= @lead.won? ? 'bg-green-100 text-green-800' : @lead.lost? ? 'bg-red-100 text-red-800' : 'bg-blue-100 text-blue-800' %>">
              <%= @lead.status.humanize %>
            </span>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-100 text-gray-800">
              <%= @lead.source.name %>
            </span>
            <% if @lead.white_label? %>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-amber-100 text-amber-800">White-label</span>
              <span class="text-sm text-gray-600">
                <%= @lead.agreement_signed_on ? "Agreement signed #{@lead.agreement_signed_on.strftime("%-d %b %Y")}" : "Agreement not signed yet" %>
              </span>
            <% end %>
            <% if @lead.reclaim? %>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-purple-100 text-purple-800">
                Reclaim
              </span>
              <% if @lead.won? && @lead.reclaim_reward_amount > 0 %>
                <span class="text-sm text-green-700">Reward: <%= format_money(@lead.reclaim_reward_amount) %></span>
              <% end %>
            <% end %>
          </div>
        </div>
        <div class="border-t border-gray-200">
          <dl>
            <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
              <dt class="text-sm font-medium text-gray-500">Description</dt>
              <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= simple_format(@lead.description) %></dd>
            </div>
            <% if @lead.lost? && @lead.lost_reason %>
              <div class="bg-red-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                <dt class="text-sm font-medium text-red-700">Lost because</dt>
                <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                  <span class="font-medium"><%= @lead.lost_reason.name %></span>
                  <%= simple_format(@lead.lost_note, class: "mt-1") %>
                </dd>
              </div>
            <% end %>
            <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
              <dt class="text-sm font-medium text-gray-500">Customer</dt>
              <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                <%= link_to @lead.customer.name, customer_path(@lead.customer), class: "text-indigo-600 hover:text-indigo-500" %>
              </dd>
            </div>
            <% if @lead.estimated_amount.present? %>
              <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                <dt class="text-sm font-medium text-gray-500">Estimated Amount</dt>
                <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= format_money(@lead.estimated_amount) %></dd>
              </div>
            <% end %>
            <% if @lead.actual_amount.present? %>
              <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                <dt class="text-sm font-medium text-gray-500">Actual Amount</dt>
                <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= format_money(@lead.actual_amount) %></dd>
              </div>
            <% end %>
            <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
              <dt class="text-sm font-medium text-gray-500">Created By</dt>
              <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= @lead.created_by.name %></dd>
            </div>
            <% if @lead.assigned_to.present? %>
              <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                <dt class="text-sm font-medium text-gray-500">Assigned To</dt>
                <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= @lead.assigned_to.name %></dd>
              </div>
            <% end %>
            <% if @lead.due_at.present? %>
              <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                <dt class="text-sm font-medium text-gray-500">Due Date</dt>
                <dd class="mt-1 text-sm <%= @lead.overdue? ? 'text-red-600 font-semibold' : @lead.due_soon? ? 'text-orange-600' : 'text-gray-900' %> sm:mt-0 sm:col-span-2">
                  <%= @lead.due_at.strftime("%B %d, %Y") %>
                  <% if @lead.overdue? %>
                    <span class="ml-2 text-red-600">(Overdue)</span>
                  <% elsif @lead.due_soon? %>
                    <span class="ml-2 text-orange-600">(Due Soon)</span>
                  <% end %>
                </dd>
              </div>
            <% end %>
            <% if @lead.next_followup_at.present? %>
              <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                <dt class="text-sm font-medium text-gray-500">Next Follow-up</dt>
                <dd class="mt-1 text-sm <%= @lead.needs_followup? ? 'text-orange-600 font-semibold' : 'text-gray-900' %> sm:mt-0 sm:col-span-2">
                  <%= @lead.next_followup_at.strftime("%B %d, %Y at %I:%M %p") %>
                  <% if @lead.needs_followup? %>
                    <span class="ml-2 text-orange-600">(Needs Follow-up)</span>
                  <% end %>
                </dd>
              </div>
            <% end %>
            <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
              <dt class="text-sm font-medium text-gray-500">Created At</dt>
              <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= @lead.created_at.strftime("%B %d, %Y at %I:%M %p") %></dd>
            </div>
          </dl>
        </div>
      </div>

      <div class="mt-6 flex items-center justify-between">
        <h2 class="text-lg font-medium text-gray-900">Assignment</h2>
        <% if policy(@lead).change_assignee? %>
          <div>
            <button type="button" onclick="forefrontOpenModal('<%= "assignment_modal_#{@lead.class.name.demodulize.underscore}_#{@lead.id}" %>')" class="bg-indigo-600 text-white px-3 py-1 rounded text-sm">Change Assignee</button>
          </div>
        <% end %>
      </div>

      <div class="mt-2">
        <%= render 'forefront/assignments/form', assignable: @lead, admins: @admins %>
      </div>

      <% if @lead.past_assignees.count > 1 && policy(@lead).update? %>
        <div class="mt-6 flex items-center justify-between">
          <h2 class="text-lg font-medium text-gray-900">Shared Credit</h2>
          <button type="button" onclick="forefrontOpenModal('<%= modal_id(:lead_share, @lead) %>')" class="bg-indigo-600 text-white px-3 py-1 rounded text-sm"><%= @lead.lead_share.present? ? "Edit Share" : "Record Share" %></button>
        </div>
        <%= render "forefront/lead_shares/form", lead: @lead %>
        <div class="mt-2 bg-white shadow overflow-hidden sm:rounded-lg p-4">
          <% if @lead.lead_share.present? %>
            <ul class="divide-y divide-gray-200">
              <% @lead.lead_share.lead_share_participants.each do |participant| %>
                <li class="py-2 flex items-center justify-between text-sm">
                  <span class="text-gray-900"><%= participant.admin.name %></span>
                  <span class="text-gray-500"><%= participant.percentage %>%</span>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-sm text-gray-500">This lead has had more than one assignee. By default, whoever holds it when it's won gets full credit — record a share only if they've mutually agreed to split it.</p>
          <% end %>
        </div>
      <% end %>

      <div id="lead_tickets" class="mt-6">
        <div class="flex items-center justify-between mb-2">
          <h2 class="text-lg font-medium text-gray-900">Tickets</h2>
          <%= link_to "New Ticket for this Lead", new_ticket_path(lead_id: @lead.id), class: "bg-indigo-600 text-white px-3 py-1 rounded text-sm" %>
        </div>
        <div class="bg-white shadow sm:rounded-lg">
          <% if @lead_tickets.any? %>
            <ul class="divide-y divide-gray-200">
              <% @lead_tickets.each do |ticket| %>
                <li class="px-4 py-3 flex items-center justify-between text-sm">
                  <span>
                    <%= link_to ticket.title, ticket_path(ticket), class: "font-medium text-indigo-600 hover:text-indigo-500" %>
                    <span class="text-gray-500">· <%= ticket.category.humanize %></span>
                  </span>
                  <span class="text-gray-500"><%= ticket.status.humanize %><%= " · #{ticket.assigned_to.name}" if ticket.assigned_to %></span>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="px-4 py-3 text-sm text-gray-500">No tickets for this lead yet.</p>
          <% end %>
        </div>
      </div>

      <% if @lead.active? && policy(@lead).update? %>
        <div class="mt-6 bg-white shadow sm:rounded-lg p-4">
          <% if @lead.awaiting_customer? %>
            <div class="flex items-center justify-between">
              <p class="text-sm text-amber-800">
                <span class="font-medium">Awaiting customer since <%= @lead.awaiting_customer_since.strftime("%-d %b") %></span>
                <% if (followup = @lead.next_followup) %>
                  · Next followup <%= followup.scheduled_for.strftime("%-d %b") %>
                <% end %>
              </p>
              <%= button_to "Customer responded", lead_awaiting_customer_path(@lead), method: :delete, class: "bg-gray-200 hover:bg-gray-300 text-gray-800 px-3 py-1 rounded text-sm" %>
            </div>
          <% else %>
            <details>
              <summary class="text-sm font-medium text-gray-700 cursor-pointer">Customer gone quiet? Mark as awaiting customer</summary>
              <%= form_with url: lead_awaiting_customer_path(@lead), scope: :followup, method: :post, class: "mt-3 grid grid-cols-1 md:grid-cols-4 gap-3 items-end" do |f| %>
                <div>
                  <%= f.label :followup_type, "Chase by", class: "block text-xs font-medium text-gray-500" %>
                  <%= f.select :followup_type, Forefront::Followup.followup_types.map { |k, _| [ k.humanize, k ] }, {}, { class: "mt-1 block w-full border rounded" } %>
                </div>
                <div>
                  <%= f.label :scheduled_for, "Followup on", class: "block text-xs font-medium text-gray-500" %>
                  <%= f.datetime_local_field :scheduled_for, required: true, class: "mt-1 block w-full border rounded" %>
                </div>
                <div>
                  <%= f.label :outcome, "Note", class: "block text-xs font-medium text-gray-500" %>
                  <%= f.text_field :outcome, class: "mt-1 block w-full border rounded" %>
                </div>
                <%= f.submit "Mark awaiting customer", class: "bg-amber-600 hover:bg-amber-700 text-white px-3 py-2 rounded text-sm" %>
              <% end %>
            </details>
          <% end %>
        </div>
      <% end %>

      <div class="mt-6 flex items-center justify-between">
        <h2 class="text-lg font-medium text-gray-900">Stage</h2>
        <% if policy(@lead).update? %>
          <div>
            <button type="button" onclick="forefrontOpenModal('<%= "status_history_modal_#{@lead.class.name.demodulize.underscore}_#{@lead.id}" %>')" class="bg-indigo-600 text-white px-3 py-1 rounded text-sm">Change Stage</button>
          </div>
        <% end %>
      </div>

      <div class="mt-2">
        <%= render 'forefront/status_histories/form', trackable: @lead %>
      </div>

      <!-- Payment Section -->
      <%= render 'forefront/payments/section', lead: @lead %>

      <!-- Followups Section -->
      <%= render 'forefront/followups/list', followupable: @lead %>
      <%= render 'forefront/followups/form', followupable: @lead %>

      <!-- Activity Form -->
      <%= render "forefront/activities/form", actable: @lead %>

      <!-- Activities List -->
      <%= render "forefront/activities/list", activities: @activities, actable: @lead %>
    </div>
  </div>
</div>

