<div class="min-h-screen bg-gray-50">
  <div class="max-w-3xl mx-auto py-6 sm:px-6 lg:px-8">
    <div class="px-4 py-6 sm:px-0">
      <h1 class="text-3xl font-bold text-gray-900 mb-6">New Lead</h1>

      <%= render "forefront/shared/messages" %>
      <% if @existing_lead %>
        <p class="mb-4 text-sm text-gray-700">Open the existing lead: <%= link_to @existing_lead.title, lead_path(@existing_lead), class: "text-indigo-600 hover:text-indigo-500" %></p>
      <% end %>

      <div class="bg-white shadow sm:rounded-lg">
        <div class="px-4 py-5 sm:p-6">
          <%= render 'form', path: leads_path %>
        </div>
      </div>
    </div>
  </div>
</div>

