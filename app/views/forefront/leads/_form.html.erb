<%= form_with model: @lead, url: path, local: true, class: "space-y-6" do |f| %>
  <div>
    <%= f.label :title, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :title, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500", required: true %>
  </div>

  <div>
    <%= f.label :description, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_area :description, rows: 4, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500", required: true %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :customer_id, "Customer", class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :customer_id, options_from_collection_for_select(@customers, :id, :full_name, @lead.customer_id), { prompt: "Select Customer" }, { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500", required: true } %>
    </div>

    <div>
      <%= f.label :assigned_to_id, "Assigned To", class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :assigned_to_id, options_from_collection_for_select(@admins, :id, :name, @lead.assigned_to_id), { include_blank: "Unassigned" }, { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" } %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :source_id, "Source", class: "block text-sm font-medium text-gray-700" %>
      <%= f.collection_select :source_id, Forefront::Source.active.or(Forefront::Source.where(id: @lead.source_id)).ordered, :id, :name, { prompt: "Select a source" }, { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500", required: true } %>
    </div>

    <div>
      <%= f.label :product_id, "Product", class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :product_id, options_from_collection_for_select(@products, :id, :name, @lead.product_id), { prompt: "Select a product" }, { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500", required: true } %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :estimated_amount, "Estimated Amount (#{currency_symbol})", class: "block text-sm font-medium text-gray-700" %>
      <%= f.number_field :estimated_amount, step: "0.01", min: 0, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
      <p class="text-xs text-gray-500 mt-1">Approximate deal value. The actual amount is asked for when the lead is won.</p>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :due_at, "Due Date", class: "block text-sm font-medium text-gray-700" %>
      <%= f.date_field :due_at, value: @lead.due_at&.strftime("%Y-%m-%d"), class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>

  </div>

  <% unless @lead.won? || @lead.lost? %>
    <div class="flex items-center">
      <%= f.check_box :private, class: "rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
      <%= f.label :private, "Private", class: "ml-2 text-sm font-medium text-gray-700" %>
      <span class="ml-2 text-xs text-gray-500">Only you, your assignee and Admins see it until it's won, lost or shared.</span>
    </div>
  <% end %>

  <div class="grid grid-cols-2 gap-4">
    <div class="flex items-center mt-6">
      <%= f.check_box :white_label, class: "rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
      <%= f.label :white_label, "White-label sale", class: "ml-2 text-sm font-medium text-gray-700" %>
    </div>
    <div>
      <%= f.label :agreement_signed_on, "Agreement signed on", class: "block text-sm font-medium text-gray-700" %>
      <%= f.date_field :agreement_signed_on, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
      <p class="text-xs text-gray-500 mt-1">White-label sales only. Doesn't hold up winning the lead.</p>
    </div>
  </div>

  <% if @lead.won? %>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :actual_amount, "Actual Amount (#{currency_symbol})", class: "block text-sm font-medium text-gray-700" %>
        <%= f.number_field :actual_amount, step: "0.01", min: 0, required: true, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
        <p class="text-xs text-gray-500 mt-1">What the deal closed for; counts toward amount-based targets.</p>
      </div>
      <div>
        <%= f.label :expires_at, "Subscription Expires", class: "block text-sm font-medium text-gray-700" %>
        <%= f.date_field :expires_at, value: @lead.expires_at&.strftime("%Y-%m-%d"), class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
        <p class="text-xs text-gray-500 mt-1">Drives renewal reminders and reclaim eligibility for this customer.</p>
      </div>
    </div>
  <% end %>

  <div class="flex justify-end space-x-3">
    <%= link_to "Cancel", path, class: "bg-gray-300 hover:bg-gray-400 text-gray-800 px-4 py-2 rounded-md text-sm font-medium" %>
    <%= f.submit class: "bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-md text-sm font-medium" %>
  </div>
<% end %>