<%# locals: trackable; on a failed submit also errors:, open: true, values: (the submitted status_history params) %>
<% values = local_assigns[:values] || {} %>
<% id = modal_id(:status_history, trackable) %>
<% term = trackable.is_a?(Forefront::Lead) ? "Stage" : "Status" %>
<% selected_status = values[:status].presence || trackable.status %>
<%= render layout: "forefront/shared/modal", locals: { id: id, title: "Change #{term}", open: local_assigns[:open], errors: local_assigns[:errors] } do %>
  <%= form_with url: polymorphic_path([trackable, :status_histories]), scope: :status_history, method: :post, data: { turbo_frame: '_top' }, html: { class: 'status-history-form' } do |f| %>
    <div class="mb-3">
      <%= f.label :status, "New #{term}", class: 'block text-sm font-medium text-gray-700' %>
      <% status_options = trackable.class.respond_to?(:statuses) ? trackable.class.statuses.map { |k, v| [v, k] } : [] %>
      <%= f.select :status, status_options, { selected: selected_status }, class: 'mt-1 block w-full border rounded', required: true, onchange: 'toggleWonAmount(this)' %>
    </div>

    <% if trackable.respond_to?(:actual_amount) %>
      <% winning = selected_status.to_s == "won" %>
      <div class="mb-3" data-won-amount style="<%= 'display:none;' unless winning %>">
        <%= f.label :actual_amount, "Actual Amount (#{currency_symbol})", class: 'block text-sm font-medium text-gray-700' %>
        <%= f.number_field :actual_amount, value: values.key?(:actual_amount) ? values[:actual_amount] : (trackable.actual_amount || trackable.estimated_amount), step: '0.01', min: 0, required: winning, class: 'mt-1 block w-full border rounded' %>
        <p class="text-xs text-gray-500 mt-1">What the deal actually closed for. Pre-filled with the estimate.</p>
      </div>
    <% end %>

    <% if trackable.is_a?(Forefront::Lead) %>
      <div class="mb-3">
        <%= f.label :ticket_due_at, "Ticket due (Demo and Proposal open a ticket for the work)", class: 'block text-sm font-medium text-gray-700' %>
        <%= f.date_field :ticket_due_at, value: values[:ticket_due_at].presence || 2.days.from_now.to_date, class: 'mt-1 block w-full border rounded' %>
      </div>

      <% losing = selected_status.to_s == "lost" %>
      <div class="mb-3" data-lost-reason style="<%= 'display:none;' unless losing %>">
        <%= f.label :lost_reason_id, "Lost reason", class: 'block text-sm font-medium text-gray-700' %>
        <%= f.collection_select :lost_reason_id, Forefront::LostReason.active.ordered, :id, :name, { prompt: "Why was it lost?", selected: values[:lost_reason_id] }, { required: losing, class: 'mt-1 block w-full border rounded' } %>
        <p class="text-xs text-gray-500 mt-1">Explain what happened in the note below; it's required for a lost lead.</p>
      </div>
    <% end %>

    <div class="mb-3">
      <%= f.label :note, 'Note (required if lost, otherwise optional)', class: 'block text-sm font-medium text-gray-700' %>
      <%= f.text_area :note, value: values[:note], rows: 3, class: 'mt-1 block w-full border rounded' %>
    </div>

    <div class="flex justify-end space-x-2">
      <button type="button" onclick="forefrontCloseModal('<%= id %>')" class="px-3 py-1 border rounded">Cancel</button>
      <%= f.submit "Change #{term}", class: 'bg-indigo-600 text-white px-3 py-1 rounded' %>
    </div>
  <% end %>

  <script>
    // Winning a Lead asks for the amount it actually closed for.
    function toggleWonAmount(select) {
      var field = select.form.querySelector('[data-won-amount]');
      if (!field) return;
      var won = select.value === 'won';
      field.style.display = won ? '' : 'none';
      field.querySelector('input').required = won;

      // Losing one asks why.
      var lost = select.value === 'lost';
      var reason = select.form.querySelector('[data-lost-reason]');
      if (reason) {
        reason.style.display = lost ? '' : 'none';
        reason.querySelector('select').required = lost;
      }
      select.form.querySelector('textarea').required = lost;
    }
  </script>
<% end %>
