<%= form_with model: @ticket, url: path, local: true, class: "mt-8 space-y-6" do |f| %>
  <div>
    <% if @ticket.lead %>
      <%= f.hidden_field :lead_id %>
      <p class="text-sm text-gray-600 mb-3">For lead <span class="font-medium"><%= @ticket.lead.title %></span></p>
    <% end %>
    <%= f.label :title, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :title, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500", required: true %>
  </div>

  <div>
    <%= f.label :description, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_area :description, rows: 4, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500", required: true %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :customer_id, "Customer", class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :customer_id, options_from_collection_for_select(@customers, :id, :full_name, @ticket.customer_id), { prompt: "Select Customer" }, { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500", required: true } %>
    </div>

    <div>
      <%= f.label :assigned_to_id, "Assigned To", class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :assigned_to_id, options_from_collection_for_select(@admins, :id, :name, @ticket.assigned_to_id), { include_blank: "Unassigned" }, { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" } %>
    </div>
  </div>

  <div class="grid grid-cols-3 gap-4">
    <div>
      <%= f.label :category, class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :category, options_for_select(Forefront::Ticket.categories.map { |k, v| [k.humanize, k] }, @ticket.category), {}, { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500", required: true } %>
    </div>

    <div>
      <%= f.label :priority, class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :priority, options_for_select(Forefront::Ticket.priorities.map { |k, v| [k.humanize, k] }, @ticket.priority || 'medium'), {}, { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500", required: true } %>
    </div>

    <div>
      <%= f.label :source_id, "Source", class: "block text-sm font-medium text-gray-700" %>
      <%= f.collection_select :source_id, Forefront::Source.active.or(Forefront::Source.where(id: @ticket.source_id)).ordered, :id, :name, { prompt: "How did they reach us?", selected: @ticket.source_id || @ticket.lead&.source_id }, { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500", required: true } %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :due_at, "Deadline", class: "block text-sm font-medium text-gray-700" %>
      <%= f.date_field :due_at, value: (@ticket.due_at || Forefront::Ticket.latest_deadline).strftime("%Y-%m-%d"), max: Forefront::Ticket.latest_deadline.strftime("%Y-%m-%d"), required: true, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
      <p class="text-xs text-gray-500 mt-1">Resolve it by then: at most <%= Forefront::Ticket.deadline_limit_days %> days from today.</p>
    </div>

  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :product_id, "Product (for renewal tickets)", class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :product_id, options_from_collection_for_select(@products, :id, :name, @ticket.product_id), { include_blank: "No product" }, { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" } %>
    </div>

    <div>
      <%= f.label :renewal_outcome, "Renewal Outcome", class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :renewal_outcome, options_for_select(Forefront::Ticket.renewal_outcomes.keys.map { |k| [k.humanize, k] }, @ticket.renewal_outcome), { include_blank: "Not resolved yet" }, { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" } %>
      <p class="text-xs text-gray-500 mt-1">Only relevant when resolving a Renewal ticket.</p>
    </div>
  </div>

  <% if @ticket.new_record? %>
    <%= render "forefront/followups/first_step_fields", required: false, values: @first_step %>
  <% end %>

  <div class="flex justify-end space-x-3">
    <%= link_to "Cancel", path, class: "bg-gray-300 hover:bg-gray-400 text-gray-800 px-4 py-2 rounded-md text-sm font-medium" %>
    <%= f.submit "Create Ticket", class: "bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-md text-sm font-medium" %>
  </div>
<% end %>