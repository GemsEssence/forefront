<div class="min-h-screen bg-gray-50">
  <div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
    <div class="px-4 py-6 sm:px-0">
      <h1 class="text-3xl font-bold text-gray-900 mb-2">Unattached receipts</h1>
      <p class="text-sm text-gray-500 mb-6">Money customers paid in a product's own app that nobody has matched to a payment yet.</p>

      <%= render "forefront/shared/messages" %>

      <div class="bg-white shadow sm:rounded-md overflow-x-auto">
        <% if @receipts.any? %>
          <table class="min-w-full divide-y divide-gray-200 text-sm">
            <thead class="bg-gray-50 text-left text-xs font-medium text-gray-500 uppercase">
              <tr>
                <th class="px-4 py-2">Paid on</th>
                <th class="px-4 py-2">Product</th>
                <th class="px-4 py-2">Customer</th>
                <th class="px-4 py-2">Amount</th>
                <th class="px-4 py-2">Reference</th>
                <th class="px-4 py-2">Attach to</th>
                <% if policy(Forefront::Receipt).discard? %><th class="px-4 py-2">Discard</th><% end %>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% @receipts.each do |receipt| %>
                <% targets = receipt.attachable_targets(@leads) %>
                <% preselected = targets.sole[1] if receipt.customer && targets.one? %>
                <tr data-receipt="<%= receipt.id %>">
                  <td class="px-4 py-2 whitespace-nowrap"><%= receipt.received_on.strftime("%-d %b %Y") %></td>
                  <td class="px-4 py-2"><%= receipt.product.name %></td>
                  <td class="px-4 py-2">
                    <% if receipt.customer %>
                      <%= link_to receipt.customer.name, customer_path(receipt.customer), class: "text-indigo-600 hover:text-indigo-500" %>
                    <% else %>
                      <span class="text-gray-500">No customer with <%= receipt.reported_phone %></span>
                    <% end %>
                  </td>
                  <td class="px-4 py-2 whitespace-nowrap"><%= format_money(receipt.amount) %></td>
                  <td class="px-4 py-2"><%= receipt.external_reference %> <span class="text-gray-500">· <%= receipt.payment_method_name %></span></td>
                  <td class="px-4 py-2">
                    <% if targets.any? %>
                      <%= form_with url: attach_unattached_receipt_path(receipt), method: :post, local: true, class: "flex items-center gap-2" do %>
                        <select name="target" class="rounded-md border-gray-300 shadow-sm text-sm">
                          <% targets.each do |label, value, owed| %>
                            <option value="<%= value %>"<%= " selected" if value == preselected %>><%= label %> (<%= format_money(owed) %> owed)</option>
                          <% end %>
                        </select>
                        <button type="submit" class="bg-green-600 hover:bg-green-700 text-white px-3 py-1 rounded text-sm">Attach</button>
                      <% end %>
                    <% else %>
                      <span class="text-gray-500">No payment to attach to yet</span>
                    <% end %>
                  </td>
                  <% if policy(Forefront::Receipt).discard? %>
                    <td class="px-4 py-2">
                      <%= form_with url: discard_unattached_receipt_path(receipt), method: :post, local: true, class: "flex items-center gap-2" do %>
                        <input type="text" name="note" placeholder="Why?" required class="w-32 rounded-md border-gray-300 shadow-sm text-sm">
                        <button type="submit" class="px-3 py-1 border rounded text-sm text-red-700 border-red-300">Discard</button>
                      <% end %>
                    </td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="px-4 py-3 text-sm text-gray-500">Nothing waiting.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>
