<%# locals: lead; on a failed submit also errors:, open: true, values: (the submitted percentages, keyed by admin id) %>
<% values = local_assigns[:values] %>
<% id = modal_id(:lead_share, lead) %>
<% even_split = (100.0 / lead.past_assignees.count).round(2) %>
<%= render layout: "forefront/shared/modal", locals: { id: id, title: "Share Credit for \"#{lead.title}\"", open: local_assigns[:open], errors: local_assigns[:errors] } do %>
  <p class="text-sm text-gray-600 mb-4">
    This Lead has been assigned to more than one Sales person. Only record this once everyone below has actually agreed, offline, to split credit for the win.
  </p>

  <%= form_with url: lead_lead_share_path(lead), method: :post, data: { turbo_frame: "_top" }, class: "space-y-4" do %>
    <% lead.past_assignees.each do |past_assignee| %>
      <% existing = lead.lead_share&.lead_share_participants&.find { |p| p.admin_id == past_assignee.id } %>
      <% value = values ? values[past_assignee.id.to_s] : (existing&.percentage || even_split) %>
      <div class="flex items-center justify-between">
        <label for="lead_share_percentage_<%= past_assignee.id %>" class="text-sm font-medium text-gray-700"><%= past_assignee.name %></label>
        <div class="flex items-center">
          <input type="number" step="0.01" min="0" max="100" id="lead_share_percentage_<%= past_assignee.id %>" name="lead_share[percentages][<%= past_assignee.id %>]" value="<%= value %>" class="w-24 rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" required>
          <span class="ml-2 text-sm text-gray-500">%</span>
        </div>
      </div>
    <% end %>

    <p class="text-xs text-gray-500">Percentages must add up to exactly 100.</p>

    <div class="flex justify-end space-x-2">
      <button type="button" onclick="forefrontCloseModal('<%= id %>')" class="px-3 py-1 border rounded">Cancel</button>
      <button type="submit" class="bg-indigo-600 text-white px-3 py-1 rounded">Record Share</button>
    </div>
  <% end %>
<% end %>
