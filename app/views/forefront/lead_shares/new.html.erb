<div class="min-h-screen bg-gray-50">
  <div class="max-w-3xl mx-auto py-6 sm:px-6 lg:px-8">
    <div class="px-4 py-6 sm:px-0">
      <h1 class="text-3xl font-bold text-gray-900 mb-6">Share Credit for "<%= @lead.title %>"</h1>

      <%= render "forefront/shared/messages" %>

      <div class="bg-white shadow sm:rounded-lg">
        <div class="px-4 py-5 sm:p-6">
          <p class="text-sm text-gray-600 mb-4">
            This Lead has been assigned to more than one Sales person. Only record this once everyone below has actually agreed, offline, to split credit for the win.
          </p>

          <% even_split = (100.0 / @lead.past_assignees.count).round(2) %>
          <%= form_with url: lead_lead_share_path(@lead), method: :post, local: true, class: "space-y-4" do %>
            <% @lead.past_assignees.each do |past_assignee| %>
              <% existing = @lead_share&.lead_share_participants&.find { |p| p.admin_id == past_assignee.id } %>
              <div class="flex items-center justify-between">
                <label class="text-sm font-medium text-gray-700"><%= past_assignee.name %></label>
                <div class="flex items-center">
                  <input type="number" step="0.01" min="0" max="100" name="lead_share[percentages][<%= past_assignee.id %>]" value="<%= existing&.percentage || even_split %>" class="w-24 rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" required>
                  <span class="ml-2 text-sm text-gray-500">%</span>
                </div>
              </div>
            <% end %>

            <p class="text-xs text-gray-500">Percentages must add up to exactly 100.</p>

            <div class="flex justify-end space-x-3">
              <%= link_to "Cancel", lead_path(@lead), class: "bg-gray-300 hover:bg-gray-400 text-gray-800 px-4 py-2 rounded-md text-sm font-medium" %>
              <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-md text-sm font-medium">Record Share</button>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
