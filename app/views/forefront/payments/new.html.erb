<div class="min-h-screen bg-gray-50">
  <div class="max-w-3xl mx-auto py-6 sm:px-6 lg:px-8">
    <div class="px-4 py-6 sm:px-0">
      <h1 class="text-3xl font-bold text-gray-900 mb-6">Record Payment for <%= @lead.title %></h1>

      <%= render "forefront/shared/messages" %>

      <div class="bg-white shadow sm:rounded-lg">
        <div class="px-4 py-5 sm:p-6">
          <%= form_with model: @payment, url: lead_payment_path(@lead), local: true, class: "space-y-6" do |f| %>
            <div>
              <%= f.label :total_amount, "Total Amount (#{currency_symbol})", class: "block text-sm font-medium text-gray-700" %>
              <%= f.text_field :total_amount, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500", required: true %>
            </div>

            <div class="flex justify-end space-x-3">
              <%= link_to "Cancel", lead_path(@lead), class: "bg-gray-300 hover:bg-gray-400 text-gray-800 px-4 py-2 rounded-md text-sm font-medium" %>
              <%= f.submit "Record Payment", class: "bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-md text-sm font-medium" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
