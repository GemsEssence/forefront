<% if lead.won? %>
  <div class="mt-6 flex items-center justify-between">
    <h2 class="text-lg font-medium text-gray-900">Payment</h2>
  </div>

  <div class="mt-2 bg-white shadow overflow-hidden sm:rounded-lg p-4">
    <% if lead.payment.nil? %>
      <% if policy(lead).update? %>
        <%= link_to "Record Payment", new_lead_payment_path(lead), class: "bg-indigo-600 hover:bg-indigo-700 text-white px-3 py-1 rounded text-sm" %>
      <% else %>
        <p class="text-sm text-gray-500">No payment recorded yet.</p>
      <% end %>
    <% else %>
      <% payment = lead.payment %>
      <div class="flex items-center justify-between mb-4">
        <p class="text-sm text-gray-900">
          Total: <span class="font-medium"><%= format_money(payment.total_amount) %></span>
          <% unless payment.fully_paid? %>
            <span class="text-gray-500">· <%= format_money(payment.still_owed) %> still owed</span>
          <% end %>
        </p>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= payment.fully_paid? ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' %>">
          <%= payment.fully_paid? ? "Paid" : "Pending" %>
        </span>
      </div>

      <% if payment.installments.any? %>
        <ul class="divide-y divide-gray-200 mb-4">
          <% payment.installments.order(:due_on).each do |installment| %>
            <li class="py-2 flex items-center justify-between">
              <span class="text-sm text-gray-900">
                <%= format_money(installment.amount) %> due <%= installment.due_on.strftime("%b %d, %Y") %>
              </span>
              <div class="flex items-center space-x-2">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium <%= installment.paid? ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' %>">
                  <%= installment.status.humanize %>
                </span>
                <% if installment.pending? %>
                  <span class="text-xs text-gray-500"><%= format_money(installment.still_owed) %> owed</span>
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
      <% end %>

      <div id="receipts" class="mb-4">
        <h3 class="text-sm font-medium text-gray-700 mb-1">Received</h3>
        <% receipts = payment.receipts.includes(:installment).order(:received_on, :id) %>
        <% if receipts.any? %>
          <ul class="divide-y divide-gray-100">
            <% receipts.each do |receipt| %>
              <li class="py-1 text-sm text-gray-900">
                <%= receipt.received_on.strftime("%-d %b %Y") %> · <%= format_money(receipt.amount) %> ·
                <%= receipt.payment_method_name %><%= " · #{receipt.reference}" if receipt.reference.present? %>
                <% if receipt.installment %><span class="text-gray-500">(installment due <%= receipt.installment.due_on.strftime("%-d %b") %>)</span><% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-sm text-gray-500">Nothing received yet.</p>
        <% end %>
      </div>

      <% if !payment.fully_paid? && policy(lead).update? %>
        <%= form_with url: lead_payment_receipts_path(lead), method: :post, scope: :receipt, local: true, class: "flex flex-wrap items-end gap-2 mb-4" do |f| %>
          <% if payment.installments.any? %>
            <div>
              <%= f.label :installment_id, "For installment", class: "block text-xs font-medium text-gray-700" %>
              <%= f.select :installment_id, payment.installments.pending.order(:due_on).map { |i| [ "#{format_money(i.amount)} due #{i.due_on.strftime("%-d %b")}", i.id ] }, {}, { class: "mt-1 block rounded-md border-gray-300 shadow-sm text-sm" } %>
            </div>
          <% end %>
          <div>
            <%= f.label :amount, "Amount received (#{currency_symbol})", class: "block text-xs font-medium text-gray-700" %>
            <%= f.number_field :amount, step: "0.01", min: 0, required: true, class: "mt-1 block w-32 rounded-md border-gray-300 shadow-sm text-sm" %>
          </div>
          <div>
            <%= f.label :received_on, "On", class: "block text-xs font-medium text-gray-700" %>
            <%= f.date_field :received_on, value: Date.current, required: true, class: "mt-1 block rounded-md border-gray-300 shadow-sm text-sm" %>
          </div>
          <div>
            <%= f.label :payment_method, "By", class: "block text-xs font-medium text-gray-700" %>
            <%= f.select :payment_method, Forefront::Receipt::PAYMENT_METHODS.invert, {}, { class: "mt-1 block rounded-md border-gray-300 shadow-sm text-sm" } %>
          </div>
          <div>
            <%= f.label :reference, "Reference", class: "block text-xs font-medium text-gray-700" %>
            <%= f.text_field :reference, class: "mt-1 block w-40 rounded-md border-gray-300 shadow-sm text-sm" %>
          </div>
          <%= f.submit "Record Receipt", class: "bg-green-600 hover:bg-green-700 text-white px-3 py-1.5 rounded text-sm" %>
        <% end %>
      <% end %>

      <% if !payment.fully_paid? && policy(lead).update? %>
        <%= form_with url: lead_payment_installments_path(lead), method: :post, scope: :installment, local: true, class: "flex items-end space-x-2 mt-2" do |f| %>
          <div>
            <%= f.label :amount, "Installment Amount (#{currency_symbol})", class: "block text-xs font-medium text-gray-700" %>
            <%= f.text_field :amount, class: "mt-1 block w-32 rounded-md border-gray-300 shadow-sm text-sm" %>
          </div>
          <div>
            <%= f.label :due_on, "Due Date", class: "block text-xs font-medium text-gray-700" %>
            <%= f.date_field :due_on, class: "mt-1 block rounded-md border-gray-300 shadow-sm text-sm" %>
          </div>
          <%= f.submit "Add Installment", class: "bg-indigo-600 hover:bg-indigo-700 text-white px-3 py-1.5 rounded text-sm" %>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
