<%# locals: record (a Lead or Ticket); on a failed submit also errors:, open: true, values: (the submitted deadline params) %>
<% values = local_assigns[:values] || {} %>
<% id = modal_id(:deadline, record) %>
<% latest = record.class.latest_deadline %>
<%= render layout: "forefront/shared/modal", locals: { id: id, title: "Extend deadline", open: local_assigns[:open], errors: local_assigns[:errors] } do %>
  <%= form_with url: polymorphic_path([ record, :deadline ]), scope: :deadline, method: :post, data: { turbo_frame: "_top" }, html: { class: "deadline-form" } do |f| %>
    <p class="text-sm text-gray-600 mb-3">
      <% if record.due_at %>Due <%= record.due_at.strftime("%-d %b %Y") %>.<% end %>
      At most <%= record.class.deadline_limit_days %> days from today.
    </p>
    <div class="mb-3">
      <%= f.label :due_at, "New deadline", class: "block text-sm font-medium text-gray-700" %>
      <%= f.date_field :due_at, value: values[:due_at].presence || latest.strftime("%Y-%m-%d"), max: latest.strftime("%Y-%m-%d"), min: Date.current.strftime("%Y-%m-%d"), required: true, class: "mt-1 block w-full border rounded" %>
    </div>
    <div class="mb-3">
      <%= f.label :note, "Why", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_area :note, value: values[:note], rows: 2, required: true, class: "mt-1 block w-full border rounded" %>
    </div>
    <div class="flex justify-end space-x-2">
      <button type="button" onclick="forefrontCloseModal('<%= id %>')" class="px-3 py-1 border rounded">Cancel</button>
      <%= f.submit "Extend deadline", class: "bg-indigo-600 text-white px-3 py-1 rounded" %>
    </div>
  <% end %>
<% end %>
