<div class="min-h-screen bg-gray-50">
  <div class="max-w-4xl mx-auto py-6 sm:px-6 lg:px-8">
    <div class="px-4 py-6 sm:px-0">
      <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold text-gray-900">Notifications</h1>
        <%= button_to "Mark all as read", read_all_notifications_path, method: :post, class: "bg-gray-200 hover:bg-gray-300 text-gray-800 px-3 py-1 rounded text-sm" %>
      </div>

      <%= render "forefront/shared/messages" %>

      <div class="bg-white shadow sm:rounded-md">
        <% if @notifications.any? %>
          <ul class="divide-y divide-gray-200">
            <% @notifications.each do |notification| %>
              <li class="px-4 py-3 flex items-center justify-between text-sm <%= 'bg-indigo-50' unless notification.read_at %>">
                <%= link_to notification.message, notification_path(notification), class: "#{notification.read_at ? 'text-gray-700' : 'font-medium text-indigo-700'} hover:underline" %>
                <span class="text-gray-500 whitespace-nowrap ml-4"><%= notification.created_at.strftime("%-d %b %H:%M") %></span>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="px-4 py-6 text-sm text-gray-500 text-center">Nothing needs your attention.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>
