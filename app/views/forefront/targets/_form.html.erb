<%= form_with model: @target, url: path, local: true, class: "space-y-6" do |f| %>
  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :admin_id, "Sales Person", class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :admin_id, options_from_collection_for_select(@sales_persons, :id, :name, @target.admin_id), { prompt: "Select Sales Person" }, { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500", required: true } %>
    </div>

    <div>
      <%= f.label :product_id, "Product", class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :product_id, options_from_collection_for_select(@products, :id, :name, @target.product_id), { prompt: "Select Product" }, { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500", required: true } %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :metric, class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :metric, options_for_select(Forefront::Target.metrics.keys.map { |k| [k.humanize, k] }, @target.metric), {}, { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500", required: true } %>
    </div>

    <div>
      <%= f.label :goal_value, "Goal", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :goal_value, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500", required: true %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :period, class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :period, options_for_select(Forefront::Target.periods.keys.map { |k| [k.humanize, k] }, @target.period), {}, { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500", required: true } %>
    </div>

    <div>
      <%= f.label :starts_on, "Period Start", class: "block text-sm font-medium text-gray-700" %>
      <%= f.date_field :starts_on, value: @target.starts_on&.strftime("%Y-%m-%d"), class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500", required: true %>
      <p class="text-xs text-gray-500 mt-1">Must be the first day of the period (e.g. Jan 1, Apr 1, Jul 1, Oct 1 for quarterly).</p>
    </div>
  </div>

  <div class="flex justify-end space-x-3">
    <%= link_to "Cancel", targets_path, class: "bg-gray-300 hover:bg-gray-400 text-gray-800 px-4 py-2 rounded-md text-sm font-medium" %>
    <%= f.submit class: "bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-md text-sm font-medium" %>
  </div>
<% end %>
