<div class="min-h-screen bg-gray-50">
  <div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
    <div class="px-4 py-6 sm:px-0">
      <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold text-gray-900">Audit log</h1>
        <%= link_to "Export CSV", audit_events_path(filter_params.to_h.symbolize_keys.merge(format: :csv)), class: "bg-gray-200 hover:bg-gray-300 text-gray-800 px-4 py-2 rounded-md text-sm font-medium" %>
      </div>

      <%= render "forefront/shared/messages" %>

      <%= form_with url: audit_events_path, method: :get, class: "mb-6 bg-white p-4 rounded-lg shadow" do |f| %>
        <div class="grid grid-cols-1 md:grid-cols-6 gap-4 items-end">
          <%= f.select :actor_id, options_from_collection_for_select(@actors, :id, :name, params[:actor_id]), { include_blank: "All staff" }, { class: "rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" } %>
          <%= f.select :auditable_type, options_for_select(@auditable_types.map { |type| [ Forefront::AuditEvent.new(auditable_type: type).auditable_kind, type ] }, params[:auditable_type]), { include_blank: "All records" }, { class: "rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" } %>
          <%= f.select :event_action, options_for_select(@event_actions.map { |action| [ action.humanize(capitalize: false), action ] }, params[:event_action]), { include_blank: "All actions" }, { class: "rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" } %>
          <div>
            <label class="block text-xs font-medium text-gray-500">From</label>
            <%= f.date_field :from, value: params[:from], class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-500">To</label>
            <%= f.date_field :to, value: params[:to], class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
          </div>
          <div class="flex space-x-2">
            <%= f.submit "Filter", class: "bg-gray-600 hover:bg-gray-700 text-white px-4 py-2 rounded-md text-sm font-medium" %>
            <%= link_to "Clear", audit_events_path, class: "bg-gray-300 hover:bg-gray-400 text-gray-800 px-4 py-2 rounded-md text-sm font-medium text-center" %>
          </div>
        </div>
      <% end %>

      <div class="bg-white shadow overflow-hidden sm:rounded-md">
        <% if @audit_events.any? %>
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">When</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Who</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Action</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Record</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Changes</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <% @audit_events.each do |event| %>
                <tr>
                  <td class="px-4 py-3 text-sm text-gray-500 whitespace-nowrap"><%= l(event.created_at, format: :short) %></td>
                  <td class="px-4 py-3 text-sm text-gray-900"><%= event.actor.name %></td>
                  <td class="px-4 py-3 text-sm text-gray-900"><%= event.action.humanize(capitalize: false) %></td>
                  <td class="px-4 py-3 text-sm text-gray-900"><%= event.auditable_type ? "#{event.auditable_kind} #{event.auditable_label}" : "—" %></td>
                  <td class="px-4 py-3 text-sm text-gray-500">
                    <% event.change_lines_for(current_admin).each do |line| %>
                      <div><%= line %></div>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
          <div class="px-4 py-3"><%= paginate @audit_events %></div>
        <% else %>
          <div class="text-center py-12">
            <p class="text-gray-500">Nothing has been recorded yet.</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
